# LFG-DJ config
#
# The app reads its Client ID from a constant in src/auth.ts, NOT from this
# file — this is just a record of the one value you need to supply.
#
# Get it from https://developer.spotify.com/dashboard (Create app → Client ID),
# then paste it into src/auth.ts:
#
#   export const SPOTIFY_CLIENT_ID: string = "paste it here";
#
# PKCE is used, so there is no client secret to put anywhere.

SPOTIFY_CLIENT_ID=
