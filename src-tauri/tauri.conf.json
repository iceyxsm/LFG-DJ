{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LFG DJ",
  "version": "0.1.0",
  "identifier": "com.lfgdj.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LFG DJ",
        "width": 1280,
        "height": 800,
        "fullscreen": false,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
